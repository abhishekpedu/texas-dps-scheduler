  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.3.0",
    "@types/prompts": "^2.4.9",
    "cross-env": "^10.1.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/lodash": "^4.17.25",
