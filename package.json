  "description": "Texas DPS Automatic Scheduler",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "cancel": "tsx src/cancel.ts",
    "cancelBooking": "tsx src/cancelBooking.ts",
    "start-debug": "NODE_ENV=development npm run start",
    "lint": "biome check src/**/*.ts",
    "postinstall": "node -e \"require('child_process').execSync('npx patchright install --with-deps --no-shell ' + (process.arch === 'arm64' ? 'chromium' : 'chrome'), {stdio: 'inherit'})\""
